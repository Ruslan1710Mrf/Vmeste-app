rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.interests is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['uid', 'name', 'city', 'interests', 'createdAt', 'photoUri', 'coverPhoto']);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'name', 'city', 'interests', 'createdAt', 'photoUri', 'coverPhoto']);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (
          (resource.data.get('authorId', null) == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId)
          || isAppendingOwnReply()
        );
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      // Любой вошедший пользователь может добавить ровно один свой комментарий
      // в конец replies, не трогая остальные поля и чужие комментарии.
      function isAppendingOwnReply() {
        let before = resource.data.get('replies', []);
        let after = request.resource.data.replies;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
          && after is list
          && after.size() == before.size() + 1
          && after[0:before.size()] == before
          && after[before.size()].authorId == request.auth.uid
          && after[before.size()].text is string;
      }
    }

    match /blocks/{blockId} {
      allow read: if request.auth != null
        && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.createdAt is string;
      allow read, update, delete: if false;
    }

    match /events/{eventId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /aiChats/{userId}/messages/{messageId} {
      // read не проверяет request.resource.data — он null для read-операций
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role in ['user', 'assistant']
        && request.resource.data.content is string
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{convId} {
      allow get: if request.auth != null
        && (
          !exists(/databases/$(database)/documents/conversations/$(convId))
          || request.auth.uid in resource.data.participants
        );
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participants[0] + '_' + request.resource.data.participants[1]))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participants[1] + '_' + request.resource.data.participants[0]));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && !exists(/databases/$(database)/documents/blocks/$(get(/databases/$(database)/documents/conversations/$(convId)).data.participants[0] + '_' + get(/databases/$(database)/documents/conversations/$(convId)).data.participants[1]))
          && !exists(/databases/$(database)/documents/blocks/$(get(/databases/$(database)/documents/conversations/$(convId)).data.participants[1] + '_' + get(/databases/$(database)/documents/conversations/$(convId)).data.participants[0]));
        allow update: if false;
        // Удаление чата стирает его у обоих участников, поэтому участник может
        // удалять и сообщения собеседника.
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    match /mail/{docId} {
      allow read, write: if false;
    }

    // Журнал серверной модерации — только Firebase Console (Admin SDK).
    match /moderationLog/{docId} {
      allow read, write: if false;
    }
  }
}
